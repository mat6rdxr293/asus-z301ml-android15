+&spm {
+	/* as on doogee-x5pro: VEN domain does not power on and blocks fb console */
+	/delete-node/ power-domain@MT6735_POWER_DOMAIN_VEN;
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-v9.dts b/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-v9.dts
