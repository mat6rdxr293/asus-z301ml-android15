+static int nt35523_boe_probe(struct mipi_dsi_device *dsi)
+{
+	struct nt35523_boe *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(&dsi->dev, struct nt35523_boe, panel,
+				   &nt35523_boe_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->dsi = dsi;
+	ctx->desc = of_device_get_match_data(&dsi->dev);
+	if (!ctx->desc)
+		return -ENODEV;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->power = devm_regulator_get(&dsi->dev, "power");
+	if (IS_ERR(ctx->power))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->power), "no power supply\n");
+	ctx->enable = devm_gpiod_get(&dsi->dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enable))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->enable), "no enable gpio\n");
+	ctx->reset = devm_gpiod_get(&dsi->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->reset), "no reset gpio\n");
+
+	ret = of_drm_get_panel_orientation(dsi->dev.of_node, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "bad orientation\n");
+
+	{
+		struct device_node *np = of_parse_phandle(dsi->dev.of_node, "asus,backlight-ic", 0);
+
+		if (np) {
+			ctx->bl_ic = of_find_i2c_device_by_node(np);
+			of_node_put(np);
+			if (!ctx->bl_ic)
+				return dev_err_probe(&dsi->dev, -EPROBE_DEFER, "LP8557 not ready\n");
+		}
+	}
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "backlight\n");
+
+	/*
+	 * LK leaves the panel powered, initialised with the vendor sequence and showing video.
+	 * Our own reset + init leaves it white on this unit, so take it over as-is: claim the
+	 * supply (else the regulator core switches the unused rail off) and only sleep/wake it.
+	 */
+	ret = regulator_enable(ctx->power);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "enable power supply\n");
+	ctx->initialised = true;
+	ctx->lk_handover = true;
+
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(&dsi->dev, ret, "failed to attach to DSI host\n");
+	}
+	return 0;
+}
+
+static void nt35523_boe_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt35523_boe *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+	if (ctx->bl_ic)
+		put_device(&ctx->bl_ic->dev);
+}
+
+static const struct of_device_id nt35523_boe_of_match[] = {
+	{ .compatible = "asus,z301ml-boe-nt35523", .data = &boe_nt35523_desc },
+	{ .compatible = "asus,z301ml-kd-otm1287a", .data = &kd_otm1287a_desc },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nt35523_boe_of_match);
+
+static struct mipi_dsi_driver nt35523_boe_driver = {
+	.driver = {
+		.name = "panel-boe-nt35523-p00l",
+		.of_match_table = nt35523_boe_of_match,
+	},
+	.probe = nt35523_boe_probe,
+	.remove = nt35523_boe_remove,
+};
+module_mipi_dsi_driver(nt35523_boe_driver);
+
+MODULE_DESCRIPTION("BOE NT35523 800x1280 DSI panel (ASUS Z301ML)");
+MODULE_LICENSE("GPL");
