diff --git a/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-android.dts b/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-android.dts
new file mode 100644
index 000000000..2c9a635af
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-android.dts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0
+// Z301ML Android boot: same board as v21 + Android cmdline + DT first-stage fstab (vendor on cache)
+#include "mt6735-asus-p00l-v23.dts"
+
+/ {
+	chosen {
+		zimage64,cmdline-override = "console=tty0 loglevel=7 printk.time=1 printk.devkmsg=on panic=5 cma=256M rdinit=/init clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=rotate:1 androidboot.hardware=mt6735 androidboot.boot_devices=soc/11230000.mmc androidboot.serialno=Z301MLP00L androidboot.selinux=permissive";
+	};
+
+	firmware {
+		android {
+			compatible = "android,firmware";
+			fstab {
+				compatible = "android,fstab";
+				vendor {
+					compatible = "android,vendor";
+					dev = "/dev/block/by-name/cache";
+					type = "ext4";
+					mnt_flags = "ro,barrier=1";
+					fsmgr_flags = "wait";
+				};
+			};
+		};
+	};
+};
+
+/* Z301ML: power button via the MT6328 PMIC (volume keys are on the SoC keypad) */
+&mt6328_keys {
+	status = "okay";
+};
+/delete-node/ &mt6328_home;
+
+/* Z301ML: backlight LED driver TI LP8557 (vendor lp8557.c); switched by the panel driver */
+&i2c3 {
+	lp8557: backlight-ic@2c {
+		compatible = "ti,lp8557";
+		reg = <0x2c>;
+	};
+};
+
+&dsi {
+	panel@0 {
+		asus,backlight-ic = <&lp8557>;
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-v10.dts b/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-v10.dts
new file mode 100644
index 000000000..e6724dea6
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6735-asus-p00l-v10.dts
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ASUS ZenPad 10 Z301ML / P00L (ASUS8735_TB_301_N)
+ * MT8735A (MT6735 family)
+ *
+ * BRING-UP V2 — build and offline analysis only, NOT validated on hardware.
+ * Extracted board wiring from factory 3.18 recovery DTB.
+ * Do not deploy without proving a reliable rollback path.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "mt6735.dtsi"
+#include "mt6328.dtsi"
+
+/ {
+	model = "MT6735";
+	compatible = "asus,z301ml", "mediatek,MT6735", "mediatek,mt6735";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	firmware {
+		android {
+			compatible = "android,firmware";
+		};
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		stdout-path = "/chosen/framebuffer";
+		zimage64,cmdline-override = "console=tty0 loglevel=8 ignore_loglevel printk.time=1 panic=0 rdinit=/init clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=rotate:1";
+
+		/* reg is patched at boot by zimage64 payload fbprobe from atag,videolfb (LK fb_base) */
+		lk_framebuffer: framebuffer {
+			compatible = "simple-framebuffer";
+			reg = <0 0 0 0x01000000>;
+			width = <800>;
+			height = <1280>;
+			stride = <3200>;
+			format = "a8r8g8b8";
+			status = "okay";
+		};
+	};
+
+	/*
+	 * The factory DTB advertises a conservative 496 MiB initial region.
+	 * Actual physical RAM appears to be ~3 GiB; mapping remaining banks
+	 * requires secure-memory and modem carveout audit first.
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x1f000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* names/compatibles as in factory DTB: stock LK walks/patches these */
+		atf-reserved-memory@43000000 {
+			compatible = "mediatek,mt6735-atf-reserved-memory", "mediatek,mt6735m-atf-reserved-memory", "mediatek,mt6753-atf-reserved-memory";
+			no-map;
+			reg = <0 0x43000000 0 0x30000>;
+		};
+
+		ram_console-reserved-memory@43f00000 {
+			compatible = "mediatek,ram_console";
+			reg = <0 0x43f00000 0 0x10000>;
+			no-map;
+		};
+
+		ramoops@43f10000 {
+			compatible = "ramoops";
+			/* console zone first and inside LK kedump window 0x43f00000..0x43f80000 */
+			reg = <0 0x43f10000 0 0x00070000>;
+			no-map;
+			record-size = <0>;
+			console-size = <0x00060000>;
+			ftrace-size = <0>;
+			pmsg-size = <0>;
+		};
+
+		minirdump-reserved-memory@43ff0000 {
+			compatible = "mediatek,minirdump";
+			reg = <0 0x43ff0000 0 0x10000>;
+			no-map;
+		};
+
+		reserve-memory-ccci_md1 {
+			compatible = "mediatek,reserve-memory-ccci_md1";
+			no-map;
+			size = <0 0x3810000>;
+			alignment = <0 0x2000000>;
+			alloc-ranges = <0 0x40000000 0 0xc0000000>;
+		};
+
+		/* reg patched at boot by zimage64 payload (OVL scanout addr) */
+		lkfb {
+			reg = <0 0 0 0x01000000>;
+			no-map;
+		};
+
+		consys-reserve-memory {
+			compatible = "mediatek,consys-reserve-memory";
+			no-map;
+			size = <0 0x100000>;
+			alignment = <0 0x200000>;
+		};
+	};
+
+};
+
+&uart0 {
+	status = "okay";
+};
+
+/* Built-in eMMC on MSDC0, x8. Keep conservative 52 MHz while bringing up. */
+&mmc0 {
+	status = "okay";
+	bus-width = <8>;
+	max-frequency = <52000000>;
+	cap-mmc-highspeed;
+	non-removable;
+	vmmc-supply = <&mt6328_vemc33_reg>;
+	vqmmc-supply = <&mt6328_vio18_reg>;
+};
+
+/*
+ * External microSD slot on MSDC1, x4.
+ * Stock DTB: GPIO11 active-low card-detect.
+ * Not essential for first boot, but board wiring is grounded.
+ */
+&mmc1 {
+	status = "okay";
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	cap-sd-highspeed;
+	cd-gpios = <&pio 11 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&mt6328_vmc_reg>;
+	vqmmc-supply = <&mt6328_vmch_reg>;
+};
+
+/*
+ * Vendor DTS: FocalTech FT5826 at I2C1 address 0x38.
+ * IRQ is GPIO10 (falling edge), reset GPIO131.
+ * Current edt-ft5x06 driver does NOT match focaltech,ft5826;
+ * keep the node disabled until a driver/ID match is confirmed.
+ */
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@38 {
+		compatible = "focaltech,ft5826";
+		reg = <0x38>;
+		interrupt-parent = <&pio>;
+		interrupts = <10 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pio 131 GPIO_ACTIVE_LOW>;
+		/* Preserve wiring, but do not bind an unverified driver. */
+		status = "disabled";
+	};
+};
+
+/*
+ * MUSB at 0x11200000 with TPHY at 0x11210000.
+ * Gadget/console needs CONFIG_USB_MUSB_MEDIATEK and a functioning UDC.
+ * No verified VBUS/PMIC role signaling yet, forcing peripheral role only.
+ */
+&usb2phy {
+	status = "okay";
+};
+
+&usb2 {
+	status = "okay";
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+
+	usb_con: connector {
+		compatible = "usb-b-connector";
+		type = "micro";
+	};
+};
+
+/*
+ * LCD: vendor lcm GPIO power=147, backlight=3, reset=146.
+ * DSI is present in mt6735.dtsi, but panel model and init sequence
+ * remain unknown. Therefore do not enable &dsi yet.
+ *
+ * PMIC, Wi-Fi, audio, LTE, camera, GPU, touch remain unsupported or
+ * unverified. This build is for UART, pstore, eMMC and USB bring-up.
+ */
+
+
+&pwrap {
+	status = "okay";
+};
+
+&spm {
+	/* as on doogee-x5pro: VEN domain does not power on and blocks fb console */
+	/delete-node/ power-domain@MT6735_POWER_DOMAIN_VEN;
+};
