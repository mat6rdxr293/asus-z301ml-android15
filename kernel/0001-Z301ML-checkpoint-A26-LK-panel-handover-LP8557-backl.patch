diff --git a/drivers/cpufreq/mt6735-cpufreq.c b/drivers/cpufreq/mt6735-cpufreq.c
new file mode 100644
index 000000000..6aadc7f82
--- /dev/null
+++ b/drivers/cpufreq/mt6735-cpufreq.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6735 (ASUS Z301ML) CPU DVFS — port of the vendor kernel-3.18 mt_cpufreq
+ * "CPU_LEVEL_1 / 1.3GHz segment" sequence:
+ *   CPU -> MAINPLL (TOP_CKMUXSEL[3:2]=2), reprogram ARMPLL_CON1 (DDS|CHG),
+ *   wait lock, CPU -> ARMPLL. Voltage (VPROC, MT6328) raised before / lowered
+ *   after the frequency change. All 4 Cortex-A53 cores share one clock.
+ */
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spinlock.h>
+
+#define INFRA_AO_BASE		0x10000000
+#define TOP_CKMUXSEL		0x000
+#define APMIXED_BASE		0x10209000
+#define AP_PLL_CON2		0x008
+#define ARMPLL_CON1		0x204
+
+#define MUX_ARMPLL		1
+#define MUX_MAINPLL		2
+
+#define PLL_FREQ_STEP		13000
+#define PLL_DIV1_FREQ		1001000
+#define PLL_DIV2_FREQ		520000
+#define PLL_DIV4_FREQ		260000
+#define DDS_DIV1_FREQ		0x0009A000
+#define DDS_DIV2_FREQ		0x010A0000
+#define DDS_DIV4_FREQ		0x020A0000
+
+static const struct { unsigned int khz, uv; } opp[] = {
+	{ 1300000, 1250000 }, { 1235000, 1231250 }, { 1170000, 1206250 },
+	{ 1040000, 1150000 }, {  819000, 1100000 }, {  598000, 1050000 },
+	{  442000, 1000000 }, {  299000,  950000 },
+};
+
+static struct cpufreq_frequency_table ftbl[ARRAY_SIZE(opp) + 1];
+static void __iomem *infra, *apmixed;
+static struct regulator *vproc;
+static DEFINE_SPINLOCK(dvfs_lock);
+static unsigned int cur_khz;
+
+static u32 dds_calc(unsigned int khz)
+{
+	if (khz >= PLL_DIV1_FREQ)
+		return DDS_DIV1_FREQ + ((khz - PLL_DIV1_FREQ) / PLL_FREQ_STEP) * 0x2000;
+	if (khz >= PLL_DIV2_FREQ)
+		return DDS_DIV2_FREQ + ((khz - PLL_DIV2_FREQ) * 2 / PLL_FREQ_STEP) * 0x2000;
+	return DDS_DIV4_FREQ + ((khz - PLL_DIV4_FREQ) * 4 / PLL_FREQ_STEP) * 0x2000;
+}
+
+static unsigned int dds_to_khz(u32 con1)
+{
+	con1 &= GENMASK(26, 0);
+	if (con1 >= DDS_DIV4_FREQ)
+		return PLL_DIV4_FREQ + ((con1 - DDS_DIV4_FREQ) / 0x2000) * PLL_FREQ_STEP / 4;
+	if (con1 >= DDS_DIV2_FREQ)
+		return PLL_DIV2_FREQ + ((con1 - DDS_DIV2_FREQ) / 0x2000) * PLL_FREQ_STEP / 2;
+	return PLL_DIV1_FREQ + ((con1 - DDS_DIV1_FREQ) / 0x2000) * PLL_FREQ_STEP;
+}
+
+static void set_mux(u32 sel)
+{
+	u32 v;
+
+	if (sel == MUX_MAINPLL) {
+		writel(readl(apmixed + AP_PLL_CON2) | BIT(5), apmixed + AP_PLL_CON2);
+		udelay(3);
+	}
+	v = readl(infra + TOP_CKMUXSEL);
+	writel((v & ~GENMASK(3, 2)) | (sel << 2), infra + TOP_CKMUXSEL);
+	if (sel == MUX_ARMPLL)
+		writel(readl(apmixed + AP_PLL_CON2) & ~BIT(5), apmixed + AP_PLL_CON2);
+}
+
+static void set_freq(unsigned int khz)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dvfs_lock, flags);
+	set_mux(MUX_MAINPLL);
+	writel(dds_calc(khz) | BIT(31), apmixed + ARMPLL_CON1);
+	udelay(20);
+	set_mux(MUX_ARMPLL);
+	spin_unlock_irqrestore(&dvfs_lock, flags);
+}
+
+static int uv_for(unsigned int khz)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(opp); i++)
+		if (opp[i].khz == khz)
+			return opp[i].uv;
+	return opp[0].uv;
+}
+
+static int mt6735_target_index(struct cpufreq_policy *policy, unsigned int idx)
+{
+	unsigned int new = ftbl[idx].frequency;
+	int ret;
+
+	if (new == cur_khz)
+		return 0;
+	if (new > cur_khz) {
+		ret = regulator_set_voltage(vproc, uv_for(new), opp[0].uv);
+		if (ret)
+			return ret;
+		udelay(50);
+		set_freq(new);
+	} else {
+		set_freq(new);
+		ret = regulator_set_voltage(vproc, uv_for(new), opp[0].uv);
+		if (ret)
+			pr_warn("mt6735-cpufreq: lower vproc failed %d\n", ret);
+	}
+	cur_khz = new;
+	return 0;
+}
+
+static unsigned int mt6735_get(unsigned int cpu)
+{
+	return dds_to_khz(readl(apmixed + ARMPLL_CON1));
+}
+
+static int mt6735_init(struct cpufreq_policy *policy)
+{
+	cpumask_setall(policy->cpus);
+	policy->freq_table = ftbl;
+	policy->cpuinfo.transition_latency = 200 * 1000;	/* ns */
+	policy->cur = mt6735_get(0);
+	return 0;
+}
+
+static struct cpufreq_driver mt6735_cpufreq_driver = {
+	.name = "mt6735-cpufreq",
+	.flags = CPUFREQ_NEED_INITIAL_FREQ_CHECK | CPUFREQ_IS_COOLING_DEV,
+	.verify = cpufreq_generic_frequency_table_verify,
+	.target_index = mt6735_target_index,
+	.get = mt6735_get,
+	.init = mt6735_init,
+};
+
+static int __init mt6735_cpufreq_init(void)
+{
+	struct device *cpu0 = get_cpu_device(0);
+	int i, uv;
+
+	if (!of_machine_is_compatible("mediatek,mt6735") || !cpu0)
+		return -ENODEV;
+	vproc = regulator_get(cpu0, "proc");
+	if (IS_ERR(vproc))
+		return PTR_ERR(vproc);
+	infra = ioremap(INFRA_AO_BASE, 0x100);
+	apmixed = ioremap(APMIXED_BASE, 0x400);
+	if (!infra || !apmixed)
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(opp); i++) {
+		ftbl[i].driver_data = i;
+		ftbl[i].frequency = opp[i].khz;
+	}
+	ftbl[i].frequency = CPUFREQ_TABLE_END;
+
+	cur_khz = mt6735_get(0);
+	uv = regulator_get_voltage(vproc);
+	pr_info("mt6735-cpufreq: boot %u kHz, vproc %d uV, mux 0x%x\n",
+		cur_khz, uv, readl(infra + TOP_CKMUXSEL));
+	/* never run a frequency above what the current voltage supports */
+	if (uv > 0 && uv < uv_for(cur_khz))
+		pr_warn("mt6735-cpufreq: vproc below table for boot freq!\n");
+	return cpufreq_register_driver(&mt6735_cpufreq_driver);
+}
+late_initcall(mt6735_cpufreq_init);
+MODULE_LICENSE("GPL");
