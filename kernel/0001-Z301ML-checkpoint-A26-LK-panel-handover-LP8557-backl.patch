@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0
+/* ASUS Z301ML (MT8735/MT6735) + MT6328 ALSA SoC machine driver (bring-up) */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/soc.h>
+
+struct mt6735_mt6328_priv {
+	struct gpio_desc *spk_amp;
+};
+
+static int ext_spk_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_card *card = snd_soc_dapm_to_card(w->dapm);
+	struct mt6735_mt6328_priv *priv = snd_soc_card_get_drvdata(card);
+
+	if (!priv->spk_amp)
+		return 0;
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		gpiod_set_value_cansleep(priv->spk_amp, 1);
+		msleep(25);	/* vendor SPK_WARM_UP_TIME */
+	} else {
+		gpiod_set_value_cansleep(priv->spk_amp, 0);
+		udelay(500);
+	}
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget mt6735_mt6328_widgets[] = {
+	SND_SOC_DAPM_SPK("Ext Spk", ext_spk_event),
+	SND_SOC_DAPM_HP("Headphone", NULL),
+};
+
+static const struct snd_soc_dapm_route mt6735_mt6328_routes[] = {
+	{"Headphone", NULL, "HPL"},
+	{"Headphone", NULL, "HPR"},
+	/* external amp input is not known yet: feed it from either codec output */
+	{"Ext Spk", NULL, "HPL"},
+	{"Ext Spk", NULL, "SPK"},
+};
+
+static const struct snd_kcontrol_new mt6735_mt6328_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Ext Spk"),
+	SOC_DAPM_PIN_SWITCH("Headphone"),
+};
+
+SND_SOC_DAILINK_DEFS(playback_1,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(playback_2,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL2")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(primary_codec,
+	DAILINK_COMP_ARRAY(COMP_CPU("ADDA")),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "mt6328-snd-codec-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link mt6735_mt6328_dai_links[] = {
+	{
+		.name = "Playback_1",
+		.stream_name = "Playback_1",
+		.trigger = {SND_SOC_DPCM_TRIGGER_PRE, SND_SOC_DPCM_TRIGGER_PRE},
+		.dynamic = 1,
+		.playback_only = 1,
+		SND_SOC_DAILINK_REG(playback_1),
+	},
+	{
+		.name = "Playback_2",
+		.stream_name = "Playback_2",
+		.trigger = {SND_SOC_DPCM_TRIGGER_PRE, SND_SOC_DPCM_TRIGGER_PRE},
+		.dynamic = 1,
+		.playback_only = 1,
+		SND_SOC_DAILINK_REG(playback_2),
+	},
+	{
+		.name = "Primary Codec",
+		.no_pcm = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(primary_codec),
+	},
+};
+
+static struct snd_soc_card mt6735_mt6328_card = {
+	.name = "z301ml-mt6328",
+	.owner = THIS_MODULE,
+	.dai_link = mt6735_mt6328_dai_links,
+	.num_links = ARRAY_SIZE(mt6735_mt6328_dai_links),
+	.dapm_widgets = mt6735_mt6328_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6735_mt6328_widgets),
+	.dapm_routes = mt6735_mt6328_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt6735_mt6328_routes),
+	.controls = mt6735_mt6328_controls,
+	.num_controls = ARRAY_SIZE(mt6735_mt6328_controls),
+};
+
+static int mt6735_mt6328_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &mt6735_mt6328_card;
+	struct device_node *platform_node, *codec_node;
+	struct mt6735_mt6328_priv *priv;
+	struct snd_soc_dai_link *dai_link;
+	int ret, i;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->spk_amp = devm_gpiod_get_optional(&pdev->dev, "spk-amp", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->spk_amp))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->spk_amp), "spk-amp gpio\n");
+
+	card->dev = &pdev->dev;
+	snd_soc_card_set_drvdata(card, priv);
+
+	platform_node = of_parse_phandle(pdev->dev.of_node, "mediatek,platform", 0);
+	if (!platform_node)
+		return dev_err_probe(&pdev->dev, -EINVAL, "mediatek,platform missing\n");
+	codec_node = of_parse_phandle(pdev->dev.of_node, "mediatek,audio-codec", 0);
+	if (!codec_node) {
+		of_node_put(platform_node);
+		return dev_err_probe(&pdev->dev, -EINVAL, "mediatek,audio-codec missing\n");
+	}
+	for_each_card_prelinks(card, i, dai_link) {
+		if (!dai_link->platforms->name)
+			dai_link->platforms->of_node = platform_node;
+		if (!dai_link->codecs->name)
+			dai_link->codecs->of_node = codec_node;
+	}
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret)
+		dev_err(&pdev->dev, "register card failed %d\n", ret);
+	of_node_put(codec_node);
+	of_node_put(platform_node);
+	return ret;
+}
+
+static const struct of_device_id mt6735_mt6328_dt_match[] = {
+	{ .compatible = "asus,z301ml-mt6328-sound" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, mt6735_mt6328_dt_match);
+
+static struct platform_driver mt6735_mt6328_driver = {
+	.driver = {
+		.name = "mt6735-mt6328",
+		.of_match_table = mt6735_mt6328_dt_match,
+	},
+	.probe = mt6735_mt6328_probe,
+};
+module_platform_driver(mt6735_mt6328_driver);
+
+MODULE_DESCRIPTION("Z301ML MT6735 + MT6328 ALSA SoC machine driver");
+MODULE_LICENSE("GPL");
