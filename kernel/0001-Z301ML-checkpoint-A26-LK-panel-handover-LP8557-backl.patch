@@ -0,0 +1,401 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6328 PMIC audio codec (DL path only) for ASUS Z301ML (MT8735/MT6735) bring-up.
+ * Register sequences follow the vendor 3.18 driver (mt_soc_audio_v3/mt_soc_codec_63xx.c).
+ */
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/mfd/mt6397/core.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+/* PMIC top */
+#define MT6328_TOP_CKPDN_CON0_SET	0x023e
+#define MT6328_TOP_CKPDN_CON0_CLR	0x0240
+#define MT6328_TOP_CKPDN_CON2_SET	0x024a
+#define MT6328_TOP_CKPDN_CON2_CLR	0x024c
+#define MT6328_TOP_CLKSQ		0x028a
+#define MT6328_TOP_CLKSQ_SET		0x028c
+#define MT6328_TOP_CLKSQ_CLR		0x028e
+/* analog */
+#define MT6328_ZCD_CON0			0x0800
+#define MT6328_ZCD_CON2			0x0804
+#define MT6328_ZCD_CON3			0x0806
+#define MT6328_ZCD_CON4			0x0808
+#define MT6328_SPK_CON0			0x0a90
+#define MT6328_SPK_CON1			0x0a92
+#define MT6328_SPK_CON2			0x0a94
+#define MT6328_SPK_CON7			0x0a9e
+#define MT6328_SPK_CON9			0x0aa2
+#define MT6328_SPK_CON13		0x0aaa
+#define MT6328_SPK_ANA_CON0		0x0ab2
+#define MT6328_SPK_ANA_CON3		0x0ab6
+#define MT6328_AUDDEC_ANA_CON0		0x0cdc
+#define MT6328_AUDDEC_ANA_CON1		0x0cde
+#define MT6328_AUDDEC_ANA_CON4		0x0ce4
+#define MT6328_AUDDEC_ANA_CON5		0x0ce6
+#define MT6328_AUDDEC_ANA_CON6		0x0ce8
+#define MT6328_AUDDEC_ANA_CON7		0x0cea
+#define MT6328_AUDDEC_ANA_CON8		0x0cec
+#define MT6328_AUDNCP_CLKDIV_CON0	0x0d04
+#define MT6328_AUDNCP_CLKDIV_CON1	0x0d06
+#define MT6328_AUDNCP_CLKDIV_CON2	0x0d08
+#define MT6328_AUDNCP_CLKDIV_CON3	0x0d0a
+#define MT6328_AUDNCP_CLKDIV_CON4	0x0d0c
+/* PMIC-side audio digital (AFE) */
+#define MT6328_AFE_UL_DL_CON0		0x2000
+#define MT6328_AFE_DL_SRC2_CON0_H	0x2002
+#define MT6328_AFE_DL_SRC2_CON0_L	0x2004
+#define MT6328_AFE_DL_SDM_CON1		0x2008
+#define MT6328_PMIC_AFE_TOP_CON0	0x2012
+#define MT6328_AFE_AUDIO_TOP_CON0	0x2014
+#define MT6328_AFUNC_AUD_CON0		0x201c
+#define MT6328_AFUNC_AUD_CON2		0x2020
+#define MT6328_AFE_PMIC_NEWIF_CFG0	0x2038
+
+enum { SPK_MODE_OFF, SPK_MODE_AB, SPK_MODE_D };
+
+struct mt6328_priv {
+	struct device *dev;
+	struct regmap *regmap;
+	unsigned int dl_rate;
+	int spk_mode;
+};
+
+static void upd(struct mt6328_priv *p, unsigned int reg, unsigned int val, unsigned int mask)
+{
+	regmap_update_bits(p->regmap, reg, mask, val);
+}
+
+static unsigned int dl_newif_rate(unsigned int rate)
+{
+	switch (rate) {
+	case 8000: return 0;
+	case 11025: return 1;
+	case 12000: return 2;
+	case 16000: return 3;
+	case 22050: return 4;
+	case 24000: return 5;
+	case 32000: return 6;
+	case 44100: return 7;
+	default: return 8; /* 48000 */
+	}
+}
+
+/* TurnOnDacPower / TurnOffDacPower (vendor) incl. ClsqEnable, Topck_Enable, NvregEnable */
+static int mt6328_dl_digital_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *k, int event)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_soc_dapm_to_component(w->dapm));
+	unsigned int r = dl_newif_rate(p->dl_rate);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		upd(p, MT6328_TOP_CLKSQ, 0x0001, 0x0001);		/* enable CLKSQ 26 MHz */
+		upd(p, MT6328_TOP_CLKSQ_SET, 0x0001, 0x0001);		/* 26 MHz source on */
+		upd(p, MT6328_TOP_CKPDN_CON0_CLR, 0x7000, 0x7000);	/* AUDNCP_CLKDIV + AUD 26M */
+		udelay(250);
+		upd(p, MT6328_AUDDEC_ANA_CON8, 0x0000, 0x0002);		/* enable AUDGLB */
+		upd(p, MT6328_AFE_AUDIO_TOP_CON0, 0x003a, 0xffff);	/* power on DL clock */
+		upd(p, MT6328_AFUNC_AUD_CON2, 0x0006, 0xffff);		/* sdm audio fifo clk */
+		upd(p, MT6328_AFUNC_AUD_CON0, 0xc3a1, 0xffff);		/* scrambler clk */
+		upd(p, MT6328_AFUNC_AUD_CON2, 0x0003, 0xffff);		/* sdm power on */
+		upd(p, MT6328_AFUNC_AUD_CON2, 0x000b, 0xffff);		/* sdm fifo enable */
+		upd(p, MT6328_AFE_DL_SDM_CON1, 0x001e, 0xffff);		/* attenuation gain */
+		upd(p, MT6328_AFE_UL_DL_CON0, 0x0001, 0xffff);		/* afe enable */
+		upd(p, MT6328_AFE_PMIC_NEWIF_CFG0, r << 12 | 0x330, 0xffff);
+		upd(p, MT6328_AFE_DL_SRC2_CON0_H, r << 12 | 0x300, 0xffff);
+		upd(p, MT6328_AFE_DL_SRC2_CON0_L, 0x0001, 0xffff);	/* DL on */
+		upd(p, MT6328_PMIC_AFE_TOP_CON0, 0x0000, 0xffff);	/* normal path, no sine gen */
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		upd(p, MT6328_AFE_DL_SRC2_CON0_L, 0x0000, 0xffff);
+		upd(p, MT6328_AFE_UL_DL_CON0, 0x0000, 0xffff);
+		udelay(250);
+		upd(p, MT6328_AFE_AUDIO_TOP_CON0, 0x0040, 0x0040);
+		upd(p, MT6328_AUDNCP_CLKDIV_CON0, 0x0000, 0xffff);
+		upd(p, MT6328_AUDNCP_CLKDIV_CON1, 0x0000, 0xffff);
+		upd(p, MT6328_AUDNCP_CLKDIV_CON3, 0x0001, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON8, 0x0002, 0x0002);
+		upd(p, MT6328_TOP_CLKSQ_CLR, 0x0001, 0x0001);
+		upd(p, MT6328_TOP_CLKSQ, 0x0000, 0x0001);
+		upd(p, MT6328_TOP_CKPDN_CON0_SET, 0x7000, 0x7000);
+		break;
+	}
+	return 0;
+}
+
+/* common analog part of Audio_Amp_Change / Speaker_Amp_Change: NCP, LDOs, NV regulator, IBIST, AUD_CLK */
+static int mt6328_dl_analog_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *k, int event)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_soc_dapm_to_component(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		upd(p, MT6328_AUDNCP_CLKDIV_CON1, 0x0001, 0xffff);	/* DA_600K_NCP_VA18 */
+		upd(p, MT6328_AUDNCP_CLKDIV_CON2, 0x002b, 0xffff);	/* NCP 604 kHz */
+		upd(p, MT6328_AUDNCP_CLKDIV_CON0, 0x0001, 0xffff);	/* toggle RG_DIVCKS_CHG */
+		upd(p, MT6328_AUDNCP_CLKDIV_CON4, 0x0000, 0xffff);
+		upd(p, MT6328_AUDNCP_CLKDIV_CON3, 0x0000, 0xffff);	/* enable NCP */
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x0a41, 0xfeeb);		/* HC LDO + VA33REFGEN */
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x2ac1, 0xfeeb);		/* LC LDO */
+		upd(p, MT6328_AUDDEC_ANA_CON7, 0x8000, 0x8000);		/* NV regulator -1.5 V */
+		upd(p, MT6328_ZCD_CON0, 0x0000, 0xffff);		/* disable ZCD */
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x2ac0, 0xfeeb);		/* IBIST */
+		udelay(50);
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x2ac2, 0xfeeb);		/* AUD_CLK */
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		upd(p, MT6328_AUDDEC_ANA_CON4, 0x0000, 0xffff);		/* drivers bias off */
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0x0000, 0xffff);		/* DAC off */
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x2ac0, 0xfeeb);		/* AUD_CLK off */
+		upd(p, MT6328_AUDDEC_ANA_CON7, 0x0000, 0x8000);		/* NV regulator off */
+		upd(p, MT6328_AUDDEC_ANA_CON6, 0x02c1, 0xfeeb);		/* LDOs/IBIST off, keep AUX det */
+		break;
+	}
+	return 0;
+}
+
+/* headphone driver (Audio_Amp_Change, analog-common part done by "DL Analog") */
+static int mt6328_hp_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *k, int event)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_soc_dapm_to_component(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xe080, 0xffff);		/* HP MUX open, voice mute */
+		upd(p, MT6328_AUDDEC_ANA_CON4, 0x0700, 0xffff);		/* HP & HS bias */
+		upd(p, MT6328_AUDDEC_ANA_CON5, 0x5490, 0xffff);		/* bias optimisation */
+		udelay(50);
+		upd(p, MT6328_ZCD_CON2, 0x0f9f, 0xffff);		/* HP gain min */
+		upd(p, MT6328_ZCD_CON3, 0x001f, 0xffff);		/* voice gain min */
+		upd(p, MT6328_AUDDEC_ANA_CON1, 0x0480, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON1, 0x1480, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xe090, 0xffff);		/* voice driver */
+		upd(p, MT6328_AUDDEC_ANA_CON1, 0x14a0, 0xffff);		/* pre-charge buffer */
+		udelay(50);
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xe09f, 0xffff);		/* audio DAC on */
+		upd(p, MT6328_ZCD_CON2, 0x0489, 0xffff);		/* HP gain -1 dB */
+		udelay(100);
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xf49f, 0xffff);		/* HP MUX -> DAC */
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xf4ff, 0xffff);		/* HPL/HPR on */
+		udelay(50);
+		upd(p, MT6328_AUDDEC_ANA_CON1, 0x1480, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON1, 0x0480, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xf46f, 0xffff);		/* voice buffer off */
+		upd(p, MT6328_AUDDEC_ANA_CON4, 0x0300, 0xffff);		/* HS bias off */
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		upd(p, MT6328_ZCD_CON2, 0x0f9f, 0xffff);
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0xf40f, 0xffff);		/* HPL/HPR off */
+		break;
+	}
+	return 0;
+}
+
+/* speaker path: IV buffer (+ internal class-AB/D amp if "Speaker Mode" != Off) */
+static int mt6328_spk_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *k, int event)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_soc_dapm_to_component(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		upd(p, MT6328_AUDDEC_ANA_CON0, 0x0009, 0x0009);		/* audio DAC Lch */
+		upd(p, MT6328_ZCD_CON0, 0x0400, 0xffff);		/* disable IVBUF_ZCD */
+		upd(p, MT6328_ZCD_CON4, 0x0705, 0xffff);		/* IV buffer 0 dB */
+		upd(p, MT6328_SPK_ANA_CON3, 0x0100, 0xffff);		/* IV buffer MUX */
+		upd(p, MT6328_SPK_ANA_CON3, 0x0110, 0xffff);		/* IV buffer on */
+		upd(p, MT6328_TOP_CKPDN_CON2_CLR, 0x0003, 0xffff);	/* class AB/D clock */
+		if (p->spk_mode == SPK_MODE_OFF)
+			break;
+		upd(p, MT6328_SPK_CON7, 0x4531, 0xffff);
+		upd(p, MT6328_SPK_CON13, 0x1800, 0xffff);
+		if (p->spk_mode == SPK_MODE_D) {
+			upd(p, MT6328_SPK_CON0, 0x3008, 0xffff);
+			upd(p, MT6328_SPK_CON2, 0x04a4, 0xffff);
+			upd(p, MT6328_SPK_ANA_CON0, 0x5000, 0xffff);
+			upd(p, MT6328_SPK_CON9, 0x2000, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x3009, 0xffff);
+			upd(p, MT6328_SPK_CON9, 0x0a00, 0xffff);
+			usleep_range(10000, 11000);			/* trim */
+			upd(p, MT6328_SPK_CON0, 0x3001, 0xffff);
+			upd(p, MT6328_SPK_CON13, 0x0000, 0xffff);
+		} else {
+			upd(p, MT6328_SPK_CON0, 0x1008, 0xffff);
+			upd(p, MT6328_SPK_CON2, 0x02a4, 0xffff);
+			upd(p, MT6328_SPK_ANA_CON0, 0x0800, 0xffff);
+			upd(p, MT6328_SPK_CON9, 0x2000, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x1009, 0xffff);
+			upd(p, MT6328_SPK_CON9, 0x0100, 0xffff);
+			usleep_range(10000, 11000);
+			upd(p, MT6328_SPK_CON0, 0x1001, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x1000, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x1004, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x1005, 0xffff);
+			upd(p, MT6328_SPK_CON13, 0x0000, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x3005, 0xffff);
+		}
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		if (p->spk_mode != SPK_MODE_OFF) {
+			upd(p, MT6328_SPK_CON9, 0x2a00, 0xffff);
+			upd(p, MT6328_SPK_CON0, 0x3000, 0xffff);	/* amp off */
+		}
+		upd(p, MT6328_TOP_CKPDN_CON2_SET, 0x0003, 0xffff);
+		upd(p, MT6328_SPK_ANA_CON3, 0x0000, 0xffff);
+		upd(p, MT6328_ZCD_CON4, 0x0707, 0xffff);
+		break;
+	}
+	return 0;
+}
+
+static const char * const spk_mode_text[] = { "Off", "ClassAB", "ClassD" };
+static SOC_ENUM_SINGLE_EXT_DECL(spk_mode_enum, spk_mode_text);
+
+static int spk_mode_get(struct snd_kcontrol *k, struct snd_ctl_elem_value *u)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_kcontrol_chip(k));
+
+	u->value.enumerated.item[0] = p->spk_mode;
+	return 0;
+}
+
+static int spk_mode_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *u)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(snd_kcontrol_chip(k));
+	int v = u->value.enumerated.item[0];
+
+	if (v > SPK_MODE_D)
+		return -EINVAL;
+	if (v == p->spk_mode)
+		return 0;
+	p->spk_mode = v;
+	return 1;
+}
+
+/* ZCD_CON2: HPL gain [4:0], HPR gain [11:7]; 0 = +8 dB ... 0x12 = -10 dB ... 0x1f = mute (vendor tables) */
+static const struct snd_kcontrol_new mt6328_controls[] = {
+	SOC_DOUBLE("Headphone Volume", MT6328_ZCD_CON2, 0, 7, 0x12, 1),
+	SOC_ENUM_EXT("Speaker Mode", spk_mode_enum, spk_mode_get, spk_mode_put),
+};
+
+static const struct snd_kcontrol_new hp_switch = SOC_DAPM_SINGLE_VIRT("Switch", 1);
+static const struct snd_kcontrol_new spk_switch = SOC_DAPM_SINGLE_VIRT("Switch", 1);
+
+static const struct snd_soc_dapm_widget mt6328_widgets[] = {
+	SND_SOC_DAPM_AIF_IN("AIF_RX", "AIF1 Playback", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_SUPPLY_S("DL Digital", 0, SND_SOC_NOPM, 0, 0, mt6328_dl_digital_event,
+			      SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_SUPPLY_S("DL Analog", 1, SND_SOC_NOPM, 0, 0, mt6328_dl_analog_event,
+			      SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_DAC("DAC", NULL, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_SWITCH("HP Path", SND_SOC_NOPM, 0, 0, &hp_switch),
+	SND_SOC_DAPM_SWITCH("SPK Path", SND_SOC_NOPM, 0, 0, &spk_switch),
+	SND_SOC_DAPM_OUT_DRV_E("HP Driver", SND_SOC_NOPM, 0, 0, NULL, 0, mt6328_hp_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUT_DRV_E("SPK Driver", SND_SOC_NOPM, 0, 0, NULL, 0, mt6328_spk_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUTPUT("HPL"),
+	SND_SOC_DAPM_OUTPUT("HPR"),
+	SND_SOC_DAPM_OUTPUT("SPK"),
+};
+
+static const struct snd_soc_dapm_route mt6328_routes[] = {
+	{"AIF_RX", NULL, "DL Digital"},
+	{"DAC", NULL, "AIF_RX"},
+	{"DAC", NULL, "DL Analog"},
+	{"HP Path", "Switch", "DAC"},
+	{"SPK Path", "Switch", "DAC"},
+	{"HP Driver", NULL, "HP Path"},
+	{"SPK Driver", NULL, "SPK Path"},
+	{"HPL", NULL, "HP Driver"},
+	{"HPR", NULL, "HP Driver"},
+	{"SPK", NULL, "SPK Driver"},
+};
+
+static int mt6328_hw_params(struct snd_pcm_substream *s, struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(dai->component);
+
+	p->dl_rate = params_rate(params);
+	return 0;
+}
+
+static const struct snd_soc_dai_ops mt6328_dai_ops = {
+	.hw_params = mt6328_hw_params,
+};
+
+static struct snd_soc_dai_driver mt6328_dai = {
+	.name = "mt6328-snd-codec-aif1",
+	.playback = {
+		.stream_name = "AIF1 Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE | SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &mt6328_dai_ops,
+};
+
+static int mt6328_component_probe(struct snd_soc_component *c)
+{
+	struct mt6328_priv *p = snd_soc_component_get_drvdata(c);
+
+	snd_soc_component_init_regmap(c, p->regmap);
+	return 0;
+}
+
+static const struct snd_soc_component_driver mt6328_component = {
+	.name = "mt6328-sound",
+	.probe = mt6328_component_probe,
+	.controls = mt6328_controls,
+	.num_controls = ARRAY_SIZE(mt6328_controls),
+	.dapm_widgets = mt6328_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6328_widgets),
+	.dapm_routes = mt6328_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt6328_routes),
+	.endianness = 1,
+};
+
+static int mt6328_codec_probe(struct platform_device *pdev)
+{
+	struct mt6328_priv *p;
+
+	p = devm_kzalloc(&pdev->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = &pdev->dev;
+	p->dl_rate = 48000;
+	p->spk_mode = SPK_MODE_OFF;
+	{
+		struct mt6397_chip *chip = dev_get_drvdata(pdev->dev.parent);
+
+		p->regmap = chip ? chip->regmap : NULL;
+	}
+	if (!p->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV, "no PMIC regmap");
+	dev_set_drvdata(&pdev->dev, p);
+	return devm_snd_soc_register_component(&pdev->dev, &mt6328_component, &mt6328_dai, 1);
+}
+
+static const struct of_device_id mt6328_codec_of_match[] = {
+	{ .compatible = "mediatek,mt6328-sound" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, mt6328_codec_of_match);
+
+static struct platform_driver mt6328_codec_driver = {
+	.driver = {
+		.name = "mt6328-sound",
+		.of_match_table = mt6328_codec_of_match,
+	},
+	.probe = mt6328_codec_probe,
+};
+module_platform_driver(mt6328_codec_driver);
+
+MODULE_DESCRIPTION("MT6328 PMIC audio codec (DL) driver");
+MODULE_LICENSE("GPL");
