+/* read panel IDs over DSI and pick the init sequence: Orise OTM1287A answers 0xA1 with xx 01 8B 12 87 */
+static const struct z301_panel_desc boe_nt35523_desc, kd_otm1287a_desc;
+
+static void z301_detect_panel(struct nt35523_boe *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	u8 a1[5] = {0}, da = 0, db = 0, dc = 0;
+	int r1, r2, r3, r4;
+
+	r1 = mipi_dsi_dcs_read(ctx->dsi, 0xda, &da, 1);
+	r2 = mipi_dsi_dcs_read(ctx->dsi, 0xdb, &db, 1);
+	r3 = mipi_dsi_dcs_read(ctx->dsi, 0xdc, &dc, 1);
+	r4 = mipi_dsi_dcs_read(ctx->dsi, 0xa1, a1, sizeof(a1));
+	dev_info(dev, "panel ID: DA=%02x(%d) DB=%02x(%d) DC=%02x(%d) A1=%5ph(%d)\n",
+		 da, r1, db, r2, dc, r3, a1, r4);
+	if (r4 >= 4 && ((a1[2] == 0x12 && a1[3] == 0x87) || (a1[3] == 0x12 && a1[4] == 0x87)))
+		ctx->desc = &kd_otm1287a_desc;
+	else
+		ctx->desc = &boe_nt35523_desc;
+	dev_info(dev, "using %s init\n", ctx->desc->name);
+}
+
+
+/* bring-up probe: which packet type does the panel accept for manufacturer regs? */
+static void z301_rb(struct nt35523_boe *ctx, const char *tag)
+{
+	u8 d1[2] = {0}, g1[2] = {0};
+	u8 reg = 0xb1;
+	int rd, rg;
+
+	rd = mipi_dsi_dcs_read(ctx->dsi, 0xb1, d1, 2);
+	rg = mipi_dsi_generic_read(ctx->dsi, &reg, 1, g1, 2);
+	dev_info(&ctx->dsi->dev, "RB[%s] B1 dcs-read=%02x %02x(%d) gen-read=%02x %02x(%d)\n",
+		 tag, d1[0], d1[1], rd, g1[0], g1[1], rg);
+}
+
+static void z301_write_probe(struct nt35523_boe *ctx)
+{
+	struct mipi_dsi_multi_context m = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&m, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&m, 0xb1, 0x12, 0x34);
+	z301_rb(ctx, "dcs-wrote-12-34");
+	mipi_dsi_generic_write_seq_multi(&m, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_generic_write_seq_multi(&m, 0xb1, 0x56, 0x78);
+	z301_rb(ctx, "gen-wrote-56-78");
+}
+
+static int nt35523_boe_prepare(struct drm_panel *panel)
+{
+	struct nt35523_boe *ctx = to_nt35523(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/*
+	 * Screen-off keeps the panel powered in DCS sleep-in (see unprepare): a full power/reset
+	 * re-init after the first one leaves this panel white. Just wake it.
+	 */
+	if (ctx->initialised) {
+		struct mipi_dsi_multi_context m = { .dsi = ctx->dsi };
+
+		/*
+		 * Straight after taking over from LK the panel shows growing column bands until it has
+		 * gone through one sleep-in/sleep-out cycle (a wake from screen-off is always clean),
+		 * so do that cycle once here.
+		 */
+		if (ctx->lk_handover) {
+			ctx->lk_handover = false;
+			mipi_dsi_dcs_set_display_off_multi(&m);
+			mipi_dsi_msleep(&m, 20);
+			mipi_dsi_dcs_enter_sleep_mode_multi(&m);
+			mipi_dsi_msleep(&m, 120);
+		}
+		mipi_dsi_dcs_exit_sleep_mode_multi(&m);
+		mipi_dsi_msleep(&m, 120);
+		mipi_dsi_dcs_set_display_on_multi(&m);
+		mipi_dsi_msleep(&m, 20);
+		if (!m.accum_err)
+			return 0;
+		dev_warn(dev, "sleep-out failed (%d), full re-init\n", m.accum_err);
+		ctx->initialised = false;
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		gpiod_set_value_cansleep(ctx->enable, 0);
+		regulator_disable(ctx->power);
+		msleep(20);
+	}
+
+	ret = regulator_enable(ctx->power);
+	if (ret) {
+		dev_err(dev, "failed to enable power supply: %d\n", ret);
+		return ret;
+	}
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->enable, 1);
+	msleep(10);
+
+	/* vendor: RST 1 -> 2ms -> 0 -> 2ms -> 1 -> 30ms (reset-gpios is active-low) */
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(30);
+
+	z301_detect_panel(ctx);
+	z301_write_probe(ctx);
+	ret = ctx->desc->init(ctx);
+	{
+		struct mipi_dsi_multi_context m = { .dsi = ctx->dsi };
+
+		mipi_dsi_generic_write_seq_multi(&m, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+		z301_rb(ctx, "after-init(expect 68 01)");
+	}
+	if (ret) {
+		dev_err(dev, "init sequence failed: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		gpiod_set_value_cansleep(ctx->enable, 0);
+		regulator_disable(ctx->power);
+		return ret;
+	}
+	dev_info(dev, "%s panel initialised\n", ctx->desc->name);
+	ctx->initialised = true;
+	return 0;
+}
+
+/*
+ * The backlight LEDs are driven by a TI LP8557 in PWM-input mode. Gating DISP_PWM does not
+ * darken it (the PWM pin does not idle low), so with the panel asleep the LEDs stay lit and the
+ * unrefreshed LCD shows white. Do what the vendor LCM driver did: BL_CMD off on disable, full
+ * register setup + BL_CMD on on enable.
+ */
+static void z301_bl_ic_on(struct nt35523_boe *ctx)
+{
+	static const u8 seq[][2] = {
+		{ 0x00, 0x00 }, { 0x10, 0x84 }, { 0x11, 0x05 }, { 0x12, 0x2c }, { 0x13, 0x03 },
+		{ 0x15, 0xc3 }, { 0x7f, 0x21 }, { 0x7a, 0x88 }, { 0x16, 0xe0 }, { 0x14, 0x9f },
+		{ 0x00, 0x01 },
+	};
+	int i, ret;
+
+	if (!ctx->bl_ic)
+		return;
+	for (i = 0; i < ARRAY_SIZE(seq); i++) {
+		ret = i2c_smbus_write_byte_data(ctx->bl_ic, seq[i][0], seq[i][1]);
+		if (ret)
+			dev_warn(&ctx->dsi->dev, "LP8557 reg %02x: %d\n", seq[i][0], ret);
+	}
+}
+
+static void z301_bl_ic_off(struct nt35523_boe *ctx)
+{
+	if (ctx->bl_ic && i2c_smbus_write_byte_data(ctx->bl_ic, 0x00, 0x00))
+		dev_warn(&ctx->dsi->dev, "LP8557 off failed\n");
+}
+
+static int nt35523_boe_enable(struct drm_panel *panel)
+{
+	z301_bl_ic_on(to_nt35523(panel));
+	return 0;
+}
+
+static int nt35523_boe_disable(struct drm_panel *panel)
+{
+	struct nt35523_boe *ctx = to_nt35523(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	z301_bl_ic_off(ctx);
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+	return dsi_ctx.accum_err;
+}
+
+static int nt35523_boe_unprepare(struct drm_panel *panel)
+{
+	struct nt35523_boe *ctx = to_nt35523(panel);
+
+	/* stay powered in sleep-in; prepare() wakes it without a re-init */
+	if (ctx->initialised)
+		return 0;
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->enable, 0);
+	regulator_disable(ctx->power);
+	return 0;
+}
