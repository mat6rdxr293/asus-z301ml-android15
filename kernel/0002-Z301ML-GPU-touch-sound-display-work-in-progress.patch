+	mipi_dsi_dcs_set_display_off_multi(&m);
+	mipi_dsi_msleep(&m, 50);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&m);
+	mipi_dsi_msleep(&m, 200);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&m);
+	mipi_dsi_msleep(&m, 150);
+	mipi_dsi_dcs_set_display_on_multi(&m);
+	dev_info(&ctx->dsi->dev, "Z301ML: LK handover sleep cycle (video on): %d\n", m.accum_err);
