+/*
+ * Z301ML: LK leaves the whole display pipeline (OVL->COLOR->...->RDMA->DSI) running. The first
+ * hw_init used to reconfigure those engines in the middle of LK's frame stream, after which the
+ * panel slowly develops column bands, while any later enable (after a real hw_fini) is clean,
+ * with identical registers. So take the pipeline over like a disable would leave it: frame sync
+ * (mutex) off, engines stopped, LK routes removed, clocks cycled. The DSI (last comp) is
+ * skipped: its stop is a refcounted poweroff. No MMSYS-wide reset.
+ */
+static void mtk_crtc_ddp_takeover_from_lk(struct mtk_crtc *mtk_crtc)
+{
+	static bool done;
+	int i;
+
+	if (done)
+		return;
+	done = true;
+
+	mtk_mutex_disable(mtk_crtc->mutex);
+	for (i = 0; i < mtk_crtc->ddp_comp_nr - 1; i++)
+		mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
+	msleep(50);	/* let LK's in-flight frame drain */
+	for (i = 0; i < mtk_crtc->ddp_comp_nr - 1; i++) {
+		if (!mtk_ddp_comp_disconnect(mtk_crtc->ddp_comp[i], mtk_crtc->mmsys_dev,
+					     mtk_crtc->ddp_comp[i + 1]->id))
+			mtk_mmsys_ddp_disconnect(mtk_crtc->mmsys_dev,
+						 mtk_crtc->ddp_comp[i]->id,
+						 mtk_crtc->ddp_comp[i + 1]->id);
+		if (!mtk_ddp_comp_remove(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
+			mtk_mutex_remove_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
+	}
+	if (!mtk_ddp_comp_remove(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
+		mtk_mutex_remove_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
+	mtk_crtc_ddp_clk_disable(mtk_crtc);
+	msleep(50);
+	if (mtk_crtc_ddp_clk_enable(mtk_crtc))
+		DRM_ERROR("Z301ML: re-enabling DDP clocks after LK takeover failed\n");
+	DRM_INFO("Z301ML: display pipeline taken over from LK (mutex off, engines stopped, clocks cycled)\n");
+}
