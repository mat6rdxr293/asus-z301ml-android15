diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index fabd732d0..131a62a81 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -36,12 +36,99 @@ static int __init cpu_psci_cpu_prepare(unsigned int cpu)
 	return 0;
 }
 
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+/*
+ * MT6735 (ASUS Z301ML bring-up): stock ATF accepts PSCI CPU_ON but does not
+ * power the core's MTCMOS; the vendor 3.18 "mt-boot" enable-method does it
+ * from the kernel via SPM right after CPU_ON. Port of spm_mtcmos_ctrl_cpuN().
+ */
+#define MT6735_SPM_BASE		0x10006000
+#define SPM_POWERON_CONFIG_SET	0x000
+#define SPM_PWR_STATUS		0x60c
+#define SPM_PWR_STATUS_2ND	0x610
+#define MTC_PWR_RST_B		BIT(0)
+#define MTC_PWR_ISO		BIT(1)
+#define MTC_PWR_ON		BIT(2)
+#define MTC_PWR_ON_2ND		BIT(3)
+#define MTC_PWR_CLK_DIS		BIT(4)
+#define MTC_SRAM_CKISO		BIT(5)
+#define MTC_SRAM_ISOINT_B	BIT(6)
+#define MTC_L1_PDN		BIT(0)
+#define MTC_L1_PDN_ACK		BIT(8)
+
+static void __iomem *mt6735_spm;
+
+static int mt6735_wait(void __iomem *reg, u32 mask, u32 val)
+{
+	int i;
+
+	for (i = 0; i < 100000; i++) {
+		if ((readl(reg) & mask) == val)
+			return 0;
+		udelay(1);
+	}
+	return -ETIMEDOUT;
+}
+
+static int mt6735_mtcmos_cpu_on(unsigned int hwcpu)
+{
+	static const u16 pwr_con[4] = { 0x200, 0x218, 0x21c, 0x220 };
+	static const u16 l1_pdn[4]  = { 0x25c, 0x264, 0x26c, 0x274 };
+	static const u32 sta_bit[4] = { BIT(9), BIT(12), BIT(11), BIT(10) };
+	void __iomem *con, *l1;
+	u32 bit;
+
+	if (hwcpu < 1 || hwcpu > 3)
+		return 0;
+	if (!mt6735_spm)
+		mt6735_spm = ioremap(MT6735_SPM_BASE, 0x1000);
+	if (!mt6735_spm)
+		return -ENOMEM;
+	con = mt6735_spm + pwr_con[hwcpu];
+	l1 = mt6735_spm + l1_pdn[hwcpu];
+	bit = sta_bit[hwcpu];
+
+	if ((readl(mt6735_spm + SPM_PWR_STATUS) & bit) &&
+	    (readl(con) & MTC_PWR_RST_B)) {
+		pr_info("mt6735-mtcmos: cpu%u already powered\n", hwcpu);
+		return 0;
+	}
+	writel((0xb16 << 16) | 1, mt6735_spm + SPM_POWERON_CONFIG_SET);
+	writel(readl(con) | MTC_PWR_ON, con);
+	udelay(1);
+	writel(readl(con) | MTC_PWR_ON_2ND, con);
+	if (mt6735_wait(mt6735_spm + SPM_PWR_STATUS, bit, bit) ||
+	    mt6735_wait(mt6735_spm + SPM_PWR_STATUS_2ND, bit, bit)) {
+		pr_err("mt6735-mtcmos: cpu%u PWR_STATUS timeout\n", hwcpu);
+		return -ETIMEDOUT;
+	}
+	writel(readl(con) & ~MTC_PWR_ISO, con);
+	writel(readl(l1) & ~MTC_L1_PDN, l1);
+	if (mt6735_wait(l1, MTC_L1_PDN_ACK, 0)) {
+		pr_err("mt6735-mtcmos: cpu%u L1_PDN_ACK timeout\n", hwcpu);
+		return -ETIMEDOUT;
+	}
+	udelay(1);
+	writel(readl(con) | MTC_SRAM_ISOINT_B, con);
+	writel(readl(con) & ~MTC_SRAM_CKISO, con);
+	writel(readl(con) & ~MTC_PWR_CLK_DIS, con);
+	writel(readl(con) | MTC_PWR_RST_B, con);
+	pr_info("mt6735-mtcmos: cpu%u powered on\n", hwcpu);
+	return 0;
+}
+
 static int cpu_psci_cpu_boot(unsigned int cpu)
 {
 	phys_addr_t pa_secondary_entry = __pa_symbol(secondary_entry);
 	int err = psci_ops.cpu_on(cpu_logical_map(cpu), pa_secondary_entry);
 	if (err && err != -EPERM)
 		pr_err("failed to boot CPU%d (%d)\n", cpu, err);
+	else if (of_machine_is_compatible("mediatek,mt6735"))
+		err = mt6735_mtcmos_cpu_on(cpu_logical_map(cpu) & 0xff);
 
 	return err;
 }
