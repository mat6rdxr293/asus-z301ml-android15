+++ b/drivers/gpu/drm/panel/panel-boe-nt35523-p00l.c
@@ -0,0 +1,308 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BOE 8" 800x1280 MIPI-DSI panel with Novatek NT35523 controller,
+ * as found in the ASUS ZenPad 10 Z301ML (P00L).
+ * Init sequence from vendor kernel-3.18 lcm nt35523_wxga_dsi_vdo_boe
+ * ("old" revision, BOE_HD_LCM=0).
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct nt35523_boe {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *power;
+	struct gpio_desc *enable;
+	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct nt35523_boe *to_nt35523(struct drm_panel *panel)
+{
+	return container_of(panel, struct nt35523_boe, panel);
+}
+
+static int nt35523_boe_init(struct nt35523_boe *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xaa, 0x55, 0x25, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x08);
+	mipi_dsi_msleep(&dsi_ctx, 1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xaa, 0x55, 0x25, 0x00);
