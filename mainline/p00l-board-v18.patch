new file mode 100644
index 000000000..fdb577534
--- /dev/null
+++ b/drivers/power/supply/z301ml-battery.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASUS ZenPad 10 Z301ML (P00L) battery: voltage/OCV based fuel gauge.
+ * The vendor uses a MediaTek software gauge; here we take VBAT/IBAT/TS/status
+ * from the BQ25896 charger power_supply and map OCV -> capacity with the
+ * vendor LG 25C profile (simple-battery ocv-capacity-table-0).
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/workqueue.h>
+#include <linux/of.h>
+
+#define POLL_MS		10000
+#define RINT_MOHM	120	/* rough pack+path resistance for IR compensation */
+
+struct zbat {
+	struct device *dev;
+	struct power_supply *psy;
+	struct power_supply *chg;
+	struct power_supply_battery_info *info;
+	struct delayed_work work;
+	int ocv_uv;		/* smoothed OCV estimate */
+	int cap;
+};
+
+static int chg_get(struct zbat *b, enum power_supply_property p, int *v)
+{
+	union power_supply_propval val;
+	int ret;
+
+	if (!b->chg)
+		return -ENODEV;
+	ret = power_supply_get_property(b->chg, p, &val);
+	if (!ret)
+		*v = val.intval;
+	return ret;
+}
+
+static void zbat_update(struct zbat *b)
+{
+	int uv = 0, ua = 0, st = POWER_SUPPLY_STATUS_UNKNOWN, ocv, cap;
+
+	if (chg_get(b, POWER_SUPPLY_PROP_VOLTAGE_NOW, &uv) || uv <= 0)
+		return;
+	chg_get(b, POWER_SUPPLY_PROP_CURRENT_NOW, &ua);
+	chg_get(b, POWER_SUPPLY_PROP_STATUS, &st);
+
+	ocv = uv;
+	/* charger reports charge current as negative/positive depending on driver; IR-compensate while charging */
+	if (st == POWER_SUPPLY_STATUS_CHARGING) {
+		int ichg = abs(ua);
+
+		if (!ichg)
+			ichg = 500000;	/* ADC not ready: assume ~0.5 A */
+		ocv -= (int)((long long)ichg * RINT_MOHM / 1000);
+	}
+	if (!b->ocv_uv)
+		b->ocv_uv = ocv;
+	else
+		b->ocv_uv = (b->ocv_uv * 3 + ocv) / 4;
+
+	cap = power_supply_batinfo_ocv2cap(b->info, b->ocv_uv, 25);
+	if (cap < 0)
+		return;
+	cap = clamp(cap, 0, 100);
+	if (st == POWER_SUPPLY_STATUS_FULL)
+		cap = 100;
+	if (cap != b->cap) {
+		b->cap = cap;
+		power_supply_changed(b->psy);
+	}
+}
+
+static void zbat_work(struct work_struct *w)
+{
+	struct zbat *b = container_of(to_delayed_work(w), struct zbat, work);
+
+	zbat_update(b);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+}
+
+static const enum power_supply_property zbat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static int zbat_get(struct power_supply *psy, enum power_supply_property p,
+		    union power_supply_propval *val)
+{
+	struct zbat *b = power_supply_get_drvdata(psy);
+	int v = 0;
+
+	switch (p) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (chg_get(b, POWER_SUPPLY_PROP_STATUS, &v))
+			v = POWER_SUPPLY_STATUS_UNKNOWN;
+		if (v == POWER_SUPPLY_STATUS_NOT_CHARGING && b->cap >= 99)
+			v = POWER_SUPPLY_STATUS_FULL;
+		val->intval = v;
+		return 0;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (b->cap < 0)
+			return -ENODATA;
+		val->intval = b->cap;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return chg_get(b, POWER_SUPPLY_PROP_VOLTAGE_NOW, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		val->intval = b->ocv_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return chg_get(b, POWER_SUPPLY_PROP_CURRENT_NOW, &val->intval);
+	case POWER_SUPPLY_PROP_TEMP:
+		return chg_get(b, POWER_SUPPLY_PROP_TEMP, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = b->info->charge_full_design_uah;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = b->info->voltage_max_design_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = b->info->voltage_min_design_uv;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static void zbat_external_changed(struct power_supply *psy)
+{
+	struct zbat *b = power_supply_get_drvdata(psy);
+
+	mod_delayed_work(system_wq, &b->work, msecs_to_jiffies(500));
+}
+
+static const struct power_supply_desc zbat_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = zbat_props,
+	.num_properties = ARRAY_SIZE(zbat_props),
+	.get_property = zbat_get,
+	.external_power_changed = zbat_external_changed,
+};
+
+static int zbat_probe(struct platform_device *pdev)
+{
+	struct power_supply_config cfg = {};
+	struct zbat *b;
+	int ret;
+
+	b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = &pdev->dev;
+	b->cap = -1;
+
+	b->chg = devm_power_supply_get_by_reference(&pdev->dev, "charger");
+	if (IS_ERR_OR_NULL(b->chg))
+		return dev_err_probe(&pdev->dev, b->chg ? PTR_ERR(b->chg) : -EPROBE_DEFER,
+				     "charger not ready\n");
+
+	cfg.drv_data = b;
+	cfg.fwnode = dev_fwnode(&pdev->dev);
+	b->psy = devm_power_supply_register(&pdev->dev, &zbat_desc, &cfg);
+	if (IS_ERR(b->psy))
+		return dev_err_probe(&pdev->dev, PTR_ERR(b->psy), "register\n");
+
+	ret = power_supply_get_battery_info(b->psy, &b->info);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "no monitored-battery info\n");
+	if (!b->info->ocv_table_size[0])
+		return dev_err_probe(&pdev->dev, -EINVAL, "no OCV table\n");
+
+	INIT_DELAYED_WORK(&b->work, zbat_work);
+	zbat_update(b);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+	dev_info(&pdev->dev, "Z301ML battery: %u uAh design, %d OCV points, capacity %d%%\n",
+		 b->info->charge_full_design_uah, b->info->ocv_table_size[0], b->cap);
+	return 0;
+}
+
+static void zbat_remove(struct platform_device *pdev)
+{
+	struct zbat *b = platform_get_drvdata(pdev);
+
+	if (b)
+		cancel_delayed_work_sync(&b->work);
+}
+
+static const struct of_device_id zbat_of_match[] = {
+	{ .compatible = "asus,z301ml-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, zbat_of_match);
+
+static struct platform_driver zbat_driver = {
+	.probe = zbat_probe,
+	.remove = zbat_remove,
+	.driver = {
+		.name = "z301ml-battery",
+		.of_match_table = zbat_of_match,
+	},
+};
+module_platform_driver(zbat_driver);
+MODULE_DESCRIPTION("ASUS Z301ML OCV-based battery gauge");
+MODULE_LICENSE("GPL");
