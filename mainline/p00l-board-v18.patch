+		/*
+		 * Factory kernel specifies a region at 0x43f10000.
+		 * On mainline use a single ramoops owner, not the overlapping
+		 * vendor ram_console (0x43f00000..0x43f80000).
+		 */
+		ramoops@43f10000 {
+			compatible = "ramoops";
+			reg = <0 0x43f10000 0 0x000e0000>;
+			record-size = <0x00080000>;
+			console-size = <0x00010000>;
+			ftrace-size = <0x00020000>;
+			pmsg-size = <0x00010000>;
+		};
+
+		minirdump@43ff0000 {
+			reg = <0 0x43ff0000 0 0x00010000>;
+			no-map;
+		};
+	};
+};
