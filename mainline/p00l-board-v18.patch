+static int nt35523_boe_get_modes(struct drm_panel *panel,
+				 struct drm_connector *connector)
+{
+	struct nt35523_boe *ctx = to_nt35523(panel);
+
+	connector->display_info.bpc = 8;
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+	return drm_connector_helper_get_modes_fixed(connector, &nt35523_boe_mode);
+}
+
+static enum drm_panel_orientation nt35523_boe_get_orientation(struct drm_panel *panel)
+{
+	return to_nt35523(panel)->orientation;
+}
+
+static const struct drm_panel_funcs nt35523_boe_funcs = {
+	.prepare = nt35523_boe_prepare,
+	.unprepare = nt35523_boe_unprepare,
+	.disable = nt35523_boe_disable,
+	.get_modes = nt35523_boe_get_modes,
+	.get_orientation = nt35523_boe_get_orientation,
+};
+
+static int nt35523_boe_probe(struct mipi_dsi_device *dsi)
+{
+	struct nt35523_boe *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(&dsi->dev, struct nt35523_boe, panel,
+				   &nt35523_boe_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->dsi = dsi;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->power = devm_regulator_get(&dsi->dev, "power");
+	if (IS_ERR(ctx->power))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->power), "no power supply\n");
+	ctx->enable = devm_gpiod_get(&dsi->dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enable))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->enable), "no enable gpio\n");
+	ctx->reset = devm_gpiod_get(&dsi->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->reset), "no reset gpio\n");
+
+	ret = of_drm_get_panel_orientation(dsi->dev.of_node, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "bad orientation\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "backlight\n");
+
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(&dsi->dev, ret, "failed to attach to DSI host\n");
+	}
+	return 0;
+}
+
+static void nt35523_boe_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt35523_boe *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
