+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ASUS ZenPad 10 Z301ML / P00L (asus8735_tb_301_n)
+ * EXPERIMENTAL MT6735 MAINLINE EARLY BRING-UP ONLY.
+ * Do not flash without validated power management and recovery procedure.
+ */
+
+/dts-v1/;
+
+#include "mt6735.dtsi"
+
+/ {
+	model = "ASUS ZenPad 10 Z301ML (P00L) - experimental";
+	compatible = "asus,z301ml", "mediatek,mt6735";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:921600n8";
+	};
+
+	/* Original ASUS DTB exposes this conservative initial RAM range. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x1f000000>;
+	};
+
+	reserved-memory {
+		ramoops@43f10000 {
+			compatible = "ramoops";
+			reg = <0 0x43f10000 0 0x000e0000>;
+			record-size = <0x00080000>;
+			console-size = <0x00010000>;
+			ftrace-size = <0x00020000>;
+			pmsg-size = <0x00010000>;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&mmc0 {
+	status = "okay";
+	bus-width = <8>;
+	max-frequency = <52000000>;
+	cap-mmc-highspeed;
+	non-removable;
+	/* PMIC-specific vmmc/vqmmc supplies have not been confirmed. */
+};
+
+/* Touchscreen, display, PMIC, Wi-Fi, audio, LTE and camera require
+ * separate hardware-specific integration.
+ */
